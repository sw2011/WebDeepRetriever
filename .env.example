# 模型 API。不要把真实密钥提交到仓库。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
WEBRETRIEVER_MODEL=gpt-4.1-mini

# kimi-k2.6 默认按组织级 3,000,000 TPM 的 80% 作为跨 Worker 预发送安全线。
MOONSHOT_TPM_LIMIT=3000000
MOONSHOT_TPM_SAFETY_RATIO=0.8

# 只能填写比赛方或宿主机已启动浏览器的 CDP URL；多个 URL 用英文逗号分隔，最多 8 个且必须互不相同。
WEBRETRIEVER_CDP_URLS=http://host.docker.internal:9222
WEBRETRIEVER_MAX_STEPS=100
WEBRETRIEVER_WORKER_WATCHDOG_SECONDS=900
WEBRETRIEVER_UPLOAD_ROOTS=/work/input

# Docker Compose 的宿主机挂载路径。输入文件必须已存在，输出目录必须允许 UID 10001 写入。
WEBRETRIEVER_INPUT_HOST=./evaluation/protocol3_sample_8.json
WEBRETRIEVER_OUTPUT_HOST=./output
